# Template for /opt/ctc-scoring/.env on the Droplet: mode 600, never committed.
# See docs/DEPLOYMENT.md "Secrets on the Droplet" and "First-time setup".

# ── Image ────────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=jschmitz
IMAGE_TAG=latest # deploy.sh rewrites this line on every deploy

# ── Host ports (host nginx proxies ctc-scoring.runvaders.com to these) ───────────
# 8080 family-scheduler, 8081 middle-school-track, 8082/8083 food-shopper
HOST_APP_PORT=8084
HOST_KONG_PORT=8085

# ── Postgres ─────────────────────────────────────────────────────────────
# No local `db` service: this app shares food-shopper's already-running
# supabase-db instance instead of running a second Postgres. `db` here
# resolves via the external `food-shopper_default` network (see
# docker-compose.yml). POSTGRES_DB is this app's own database inside that
# shared instance (created once as part of first-time setup; see
# docs/DEPLOYMENT.md). POSTGRES_PASSWORD is NOT freshly generated: it must be
# the exact same value as food-shopper's, because `authenticator` and
# `supabase_admin` are cluster-wide roles whose password is already set to
# that value -- a different value here will fail to authenticate.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ctc_scoring
POSTGRES_PASSWORD= # copy from /opt/food-shopper/.env -- do not generate a new one

# ── JWT / API keys: output of deploy/gen-keys.sh ────────────────────────
# Independent from food-shopper's: auth/rest/realtime are this app's own
# containers, so sign-in and API tokens are scoped to ctc_scoring only.
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY= # also the GitHub secret NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SERVICE_ROLE_KEY=
REALTIME_SECRET_KEY_BASE=

# ── Auth (GoTrue) ────────────────────────────────────────────────────────
SITE_URL=https://ctc-scoring.runvaders.com
API_EXTERNAL_URL=https://ctc-scoring.runvaders.com
ADDITIONAL_REDIRECT_URLS=https://ctc-scoring.runvaders.com/**
# Anyone can request a sign-in link; only emails in the `staff` table can
# write (row-level security). DISABLE_SIGNUP=true would mean inviting each
# volunteer through GoTrue instead.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# Magic links are the only way to sign in, so this must be a working relay.
# Reusing food-shopper's relay is fine; consider a runvaders.com sender.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=CTC Scoring

# ── PostgREST ────────────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,graphql_public

# ── Backups (deploy/backup.sh) ──────────────────────────────────────────
# An rclone remote (`rclone config`), e.g. a DigitalOcean Spaces bucket.
# Unset, backups stay on the Droplet and the nightly job warns about it.
RCLONE_REMOTE=
