# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local state (also covered by supabase/.gitignore)
supabase/.branches
supabase/.temp

# test output
/test-results/
/playwright-report/

# logs
*.log

# database dumps (from deploy backups or manual pg_dump)
*.sql.gz
*.dump

# editors and OS
.vscode/
.idea/
*.swp
Thumbs.db

# Word/Office lock files (e.g. while the rules .docx is open)
~$*

# personal Claude Code settings (shared ones like .claude/launch.json stay tracked)
.claude/settings.local.json
